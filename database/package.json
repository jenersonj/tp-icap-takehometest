{
  "name": "@blotter/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Prisma schema, migrations and the random trade generator used for seeding",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist",
    "prisma",
    "prisma.config.ts"
  ],
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "generate": "prisma generate",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "studio": "prisma studio"
  },
  "dependencies": {
    "@blotter/contracts": "workspace:*",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1"
  },
  "devDependencies": {
    "@blotter/config": "workspace:*",
    "eslint": "^10.14.0",
    "prisma": "^7.10.1",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
