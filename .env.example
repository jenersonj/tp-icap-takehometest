# Copy to .env to override the defaults used by docker-compose.yml and `pnpm dev`.

# Postgres
POSTGRES_USER=blotter
POSTGRES_PASSWORD=blotter
POSTGRES_DB=blotter
POSTGRES_PORT=5432
DATABASE_URL=postgresql://blotter:blotter@localhost:5432/blotter

# RabbitMQ
RABBITMQ_USER=blotter
RABBITMQ_PASSWORD=blotter
RABBITMQ_URL=amqp://blotter:blotter@localhost:5672
RABBITMQ_EXCHANGE=blotter

# API (BFF)
API_PORT=3000
RPC_TIMEOUT_MS=5000

# Realtime
REALTIME_PORT=3001
CORS_ORIGINS=http://localhost:8080

# Web
WEB_PORT=8080
API_INTERNAL_URL=http://localhost:3000
REALTIME_INTERNAL_URL=http://localhost:3001
