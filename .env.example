# Copy to .env to override the defaults used by docker-compose.yml and `pnpm dev`.

# Postgres
POSTGRES_USER=blotter
POSTGRES_PASSWORD=blotter
POSTGRES_DB=blotter
POSTGRES_PORT=5432
DATABASE_URL=postgresql://blotter:blotter@localhost:5432/blotter

# RabbitMQ
RABBITMQ_USER=blotter
RABBITMQ_PASSWORD=blotter
RABBITMQ_URL=amqp://blotter:blotter@localhost:5672
RABBITMQ_EXCHANGE=blotter

# Trade service
# HS256 key for access tokens (32+ chars). Change it for anything beyond local demo use.
JWT_SECRET=dev-only-jwt-secret-change-me-in-any-real-deployment
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
# Mock market price ticker interval in ms (0 disables it)
PRICE_TICK_MS=2000

# API (BFF)
API_PORT=3000
RPC_TIMEOUT_MS=5000

# Realtime
REALTIME_PORT=3001
CORS_ORIGINS=http://localhost:8080

# Web
WEB_PORT=8080
API_INTERNAL_URL=http://localhost:3000
REALTIME_INTERNAL_URL=http://localhost:3001
