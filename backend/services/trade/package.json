{
  "name": "@blotter/trade-service",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "NestJS microservice: the initial domain service. Hosts trades, audit, positions, pricing and auth (Clean Architecture + CQRS, Prisma) until they are split out",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --preserveWatchOutput",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.int.config.mts --passWithNoTests"
  },
  "dependencies": {
    "@blotter/contracts": "workspace:*",
    "@blotter/database": "workspace:*",
    "@blotter/messaging": "workspace:*",
    "@nestjs/common": "^12.4.2",
    "@nestjs/core": "^12.4.2",
    "@nestjs/cqrs": "^12.1.2",
    "@nestjs/microservices": "^12.4.2",
    "amqp-connection-manager": "^5.0.1",
    "amqplib": "^0.10.9",
    "prisma": "^7.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@blotter/config": "workspace:*",
    "@nestjs/cli": "^12.0.12",
    "@nestjs/testing": "^12.4.2",
    "@swc/core": "^1.16.22",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "typescript": "~6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
