{
  "name": "@blotter/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "NestJS BFF: HTTP /api/v1, cookie auth, zod shape validation, maps service replies to frontend DTOs",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --preserveWatchOutput",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.int.config.mts --passWithNoTests"
  },
  "dependencies": {
    "@blotter/contracts": "workspace:*",
    "@blotter/messaging": "workspace:*",
    "@nestjs/common": "^12.4.2",
    "@nestjs/core": "^12.4.2",
    "@nestjs/microservices": "^12.4.2",
    "@nestjs/platform-express": "^12.4.2",
    "amqp-connection-manager": "^5.0.1",
    "amqplib": "^0.10.9",
    "cookie-parser": "^1.4.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@blotter/config": "workspace:*",
    "@nestjs/cli": "^12.0.12",
    "@nestjs/testing": "^12.4.2",
    "@swc/core": "^1.16.22",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/node": "^24.19.2",
    "@types/supertest": "^6.0.3",
    "eslint": "^10.14.0",
    "supertest": "^7.1.4",
    "typescript": "~6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
