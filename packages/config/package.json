{
  "name": "@blotter/config",
  "version": "0.0.0",
  "private": true,
  "description": "Shared tsconfig, eslint, prettier and vitest presets",
  "exports": {
    "./tsconfig/base.json": "./tsconfig/base.json",
    "./tsconfig/library.json": "./tsconfig/library.json",
    "./tsconfig/nest.json": "./tsconfig/nest.json",
    "./tsconfig/nextjs.json": "./tsconfig/nextjs.json",
    "./vitest": {
      "types": "./vitest/preset.d.mts",
      "default": "./vitest/preset.mjs"
    },
    "./eslint": "./eslint/index.mjs"
  },
  "dependencies": {
    "@eslint/js": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "typescript-eslint": "^8.72.2"
  },
  "peerDependencies": {
    "eslint": "^9",
    "vitest": "^3"
  }
}
